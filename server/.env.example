# ===========================================================================
# API (Node + Express → Railway)
#
# Copy to `server/.env` for local work. On Railway these go in
# Service → Variables.
# ===========================================================================

# ── Required ───────────────────────────────────────────────────────────────
# Supabase project URL and SERVICE ROLE key. The service role key bypasses row
# level security. It must never appear in frontend code, in the repository, or
# in any variable beginning VITE_.
# Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call this API, comma separated, no trailing
# slashes. Add your Vercel production URL or every request is blocked by CORS.
# Once one *.vercel.app origin is listed, preview deploys are allowed too.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ── DronaHQ agents ─────────────────────────────────────────────────────────
# One webhook URL per agent. An agent with no URL or no key runs on the
# built-in engine instead, and every run records which engine served it.
#
# Note the two that do not match their internal name: ICP Fitment reads
# DRONAHQ_ICP_URL, and Outreach Strategy reads DRONAHQ_STRATEGY_URL.

# One key for all five:
DRONAHQ_API_KEY=

DRONAHQ_RESEARCH_URL=
DRONAHQ_ICP_URL=
DRONAHQ_STRATEGY_URL=
DRONAHQ_PERSONALISATION_URL=
DRONAHQ_CONVERSATION_URL=

# Per-agent keys, only if one agent uses a different key from the shared one.
DRONAHQ_RESEARCH_KEY=
DRONAHQ_ICP_KEY=
DRONAHQ_STRATEGY_KEY=
DRONAHQ_PERSONALISATION_KEY=
DRONAHQ_CONVERSATION_KEY=

# ── Optional ───────────────────────────────────────────────────────────────
# Do not set PORT on Railway. Point the generated domain at 3001 instead,
# which is what the server listens on when PORT is absent.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Background worker. Off by default: during a demo you drive the pipeline from
# the app, and a worker firing between takes moves prospects out from under
# you. Turn it on for a deployment that should keep working unattended.
WORKER_ENABLED=false
WORKER_POLL_MS=30000
WORKER_BATCH_SIZE=5

# Guardrails.
MAX_AGENT_CALLS_PER_DAY=250
AGENT_TIMEOUT_MS=45000
COST_PER_1K_TOKENS_USD=0.015

# Set false to make a failed DronaHQ call stop the step instead of falling
# back to the built-in engine.
LOCAL_ENGINE_ENABLED=true
