# ===========================================================================
# API (Node + Express → Railway)
#
# Copy to `server/.env` for local work. On Railway these go in
# Service → Variables.
# ===========================================================================

# ── Required ───────────────────────────────────────────────────────────────
# Supabase project URL and SERVICE ROLE key. The service role key bypasses row
# level security. It must never appear in frontend code, in the repository, or
# in any variable beginning VITE_.
# Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call this API, comma separated, no trailing
# slashes. Add your Vercel production URL or every request is blocked by CORS.
# Once one *.vercel.app origin is listed, preview deploys are allowed too.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app


# ── The intelligence layer: Groq, then Gemini ──────────────────────────────
#
# Each provider holds a pool of up to SIX keys. More than one key is not
# redundancy theatre: a free-tier key runs out of requests part way through a
# campaign run, and with one key that stops the run. With six, the pool
# benches the rate-limited key for a cooldown and the run carries on.
#
# Three ways to give the keys, all read and merged, so you can use whichever
# suits where you are pasting them:
#
#   GROQ_API_KEY=key1,key2,key3      one variable, comma separated
#   GROQ_API_KEYS=key1,key2          the plural spelling, same thing
#   GROQ_API_KEY_1 … GROQ_API_KEY_6  one variable per key
#
# Duplicates are dropped. Anything past six is ignored. The Agents screen
# shows every key's state, redacted, and which one served each run.
#
# Leave them all blank and the pipeline runs on the deterministic local
# engine instead — every run says which engine produced it either way.

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_MODEL=llama3-70b-8192
# Tried in order if the model above is rejected as unknown. A retired model
# name is one of the most common ways this layer breaks, and without a ladder
# it presents as "every provider failed", which sends you looking at keys.
GROQ_MODEL_FALLBACKS=llama3-8b-8192,llama3-70b-8192

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

LLM_PROVIDER_ORDER=groq,gemini
LLM_TIMEOUT_MS=30000


# ── Finding prospects ──────────────────────────────────────────────────────
#
# auto    Apollo when APOLLO_API_KEY is set, model suggestions when it is not
# apollo  Apollo only; refuses rather than downgrading if the key is missing
# llm     model suggestions only
# none    no discovery; prospects are imported by hand
DISCOVERY_SOURCE=auto
DISCOVERY_MAX_PER_RUN=25

# Apollo. Settings → Integrations → API in your Apollo account.
# Searching costs nothing. Revealing an email costs one credit per person,
# so it is off by default: a demo should not quietly drain an account.
# Without it, people are stored with a null email rather than with Apollo's
# email_not_unlocked@domain.com placeholder, which would look deliverable
# and is not.
APOLLO_API_KEY=
APOLLO_REVEAL_EMAILS=false
APOLLO_TIMEOUT_MS=20000


# ── Running ────────────────────────────────────────────────────────────────
# Do not set PORT on Railway. Point the generated domain at 3001 instead,
# which is what the server listens on when PORT is absent.
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# How many prospects one run works on at the same time. Two halves wall-clock
# time against one; higher mostly buys rate limits rather than speed.
JOB_CONCURRENCY=2
# A prospect whose lock is older than this is assumed abandoned — the process
# holding it died mid-step — and can be picked up again.
JOB_LOCK_TTL_MS=300000

# Background worker. Off by default: during a demo you drive the pipeline from
# the app, and a worker firing between takes moves prospects out from under
# you. Turn it on for a deployment that should keep working unattended.
WORKER_ENABLED=false
WORKER_POLL_MS=30000
WORKER_BATCH_SIZE=5

# Guardrails.
MAX_AGENT_CALLS_PER_DAY=250
AGENT_TIMEOUT_MS=45000
COST_PER_1K_TOKENS_USD=0.015

# Set false to make a failed Groq and Gemini call stop the step instead of
# falling back to the built-in engine.
LOCAL_ENGINE_ENABLED=true
