# ===========================================================================
# Frontend (Vite → Vercel)
#
# Copy to `.env` for local work. On Vercel these go in
# Project Settings → Environment Variables.
#
# Vite bakes VITE_* values in at BUILD time. Changing one on Vercel does
# nothing until you redeploy.
# ===========================================================================

# Required. The Railway URL of the API, no trailing slash.
VITE_API_BASE_URL=https://your-api.up.railway.app

# Optional. Set both to require a real sign-in. Leave them blank and the app
# opens with one click and says so on the entry screen.
#
# The anon key is the only Supabase key allowed anywhere near the browser, and
# it is used for sign-in alone. No screen reads application data from Supabase
# directly; everything comes through the API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
